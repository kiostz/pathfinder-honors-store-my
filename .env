# Site settings for every mode; public by design (read by the browser). The Web3Forms access key is a placeholder until the order handler's key exists.
VITE_WEB3FORMS_ACCESS_KEY=placeholder-access-key
# Web3Forms' shared hCaptcha sitekey, used by the production build.
VITE_HCAPTCHA_SITEKEY=50b2fe65-b00b-4b9e-ad62-3ba471098be2
